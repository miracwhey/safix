{
  "name": "fix-up",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "patch-package",
    "predev": "node scripts/assert-canonical-repo.mjs",
    "dev": "vite",
    "prebuild": "node scripts/assert-canonical-repo.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config e2e/playwright.config.ts --debug",
    "type-check": "tsc -b",
    "type-check:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test:ci": "vitest run",
    "ci": "npm run type-check && npm run lint && npm run test:ci",
    "cap:sync": "cap sync",
    "cap:open": "cap open ios",
    "cap:build": "npm run build && rm -rf dist/spatial-assets/materials dist/spatial-assets/hdri dist/spatial-assets/thumbnails && cap sync",
    "check:plugin-privacy": "bash scripts/check-plugin-privacy.sh",
    "semgrep": "semgrep --config .semgrep/ --error",
    "dev:recovery-link": "node scripts/dev/native-recovery-link.mjs",
    "spatial:sync-basis": "cp node_modules/three/examples/jsm/libs/basis/basis_transcoder.js node_modules/three/examples/jsm/libs/basis/basis_transcoder.wasm public/spatial-basis/"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "file:packages/capacitor-apple-signin",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fixup/capacitor-roomplan": "file:packages/capacitor-roomplan",
    "@google/model-viewer": "^4.2.0",
    "@independo/capacitor-voice-recorder": "^8.2.9",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@revenuecat/purchases-capacitor": "^13.1.0",
    "@revenuecat/purchases-capacitor-ui": "^13.1.0",
    "@sentry/capacitor": "4.2.0",
    "@sentry/node": "10.60.0",
    "@sentry/react": "10.60.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@types/pako": "^2.0.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "ajv": "^6.15.0",
    "browser-image-compression": "^2.0.2",
    "heic2any": "^0.0.4",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "n8ao": "^1.10.1",
    "nipplejs": "^1.0.3",
    "pako": "^2.1.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.26.2",
    "stripe": "^20.4.1",
    "three": "^0.182.0",
    "three-bvh-csg": "^0.0.17",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.184.1",
    "@vercel/node": "^5.6.15",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "patch-package": "^8.0.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "flatted": ">=3.4.0",
    "path-to-regexp": "6.3.0",
    "undici": ">=6.24.0",
    "serialize-javascript": ">=7.0.5",
    "smol-toml": ">=1.6.1",
    "esbuild": ">=0.28.1",
    "form-data": ">=4.0.6",
    "tmp": ">=0.2.7",
    "dompurify": ">=3.4.12",
    "tar": ">=7.5.19",
    "@vercel/python-analysis": {
      "minimatch": ">=10.2.3"
    },
    "@vercel/static-config": {
      "ajv": ">=8.18.0"
    }
  }
}
