# =============================================================================
# FixUp – Environment Variable Reference
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Never commit a .env file with real credentials to version control.
# For Vercel deployments, set these variables in your Vercel project settings
# under Settings → Environment Variables.
# =============================================================================


# -----------------------------------------------------------------------------
# DATA SOURCE
# -----------------------------------------------------------------------------
# Controls which storage backend is used for all domain repositories.
#
# 'in-memory'  (default) — Fast, zero-config local development. All data is
#              ephemeral and lives only in browser memory. No network calls.
#              Safe to use without any credentials.
#
# 'supabase'   — Connects to a real Supabase project. Requires the two
#              VITE_SUPABASE_* variables below. Apply the migrations in
#              supabase/migrations/ before switching to this mode.
#
# AUTO-DETECTION: If both VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are
#              set, the runtime automatically uses Supabase even when this
#              variable is absent. This prevents a silent split-brain where
#              auth and provider discovery (which always use Supabase) would
#              diverge from the repository-backed domains (jobs, messages,
#              payments, disputes, projects, …) still writing to in-memory.
#
# VERCEL: Setting VITE_DATA_SOURCE=supabase is recommended but optional when
#         both Supabase credential variables are present.
VITE_DATA_SOURCE=in-memory


# -----------------------------------------------------------------------------
# SUPABASE CREDENTIALS  (required when VITE_DATA_SOURCE=supabase)
# -----------------------------------------------------------------------------
# Find these in your Supabase project under:
#   Project Settings → API → Project URL / anon (public) key
#
# Steps to activate Supabase:
#   1. Create a Supabase project at https://supabase.com.
#   2. Apply all migrations:
#        supabase db push               # using the Supabase CLI
#        -- or run the SQL files in supabase/migrations/ via the SQL Editor.
#   3. Copy the Project URL and anon key below.
#   4. Optionally set VITE_DATA_SOURCE=supabase (the runtime auto-detects
#      Supabase mode when both credentials below are present).
#
# Note: The anon key is a safe, public-facing key. It is intentionally exposed
# in the client bundle and is subject to Row Level Security policies in Supabase.
#
# VERCEL: Add these in project Settings → Environment Variables.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-public-key>


# -----------------------------------------------------------------------------
# PAYMENT PROVIDER
# -----------------------------------------------------------------------------
# Controls which payment implementation is active.
#
# 'mock'   (default) — Simulated payments; no real money moves. Safe for
#          local development and demo environments.
#
# 'stripe' — Real Stripe integration. Requires the VITE_STRIPE_* variables
#          below and the server-side STRIPE_SECRET_KEY in Vercel.
#
# VERCEL: Set to 'stripe' for production deployments with real payments.
VITE_PAYMENT_PROVIDER=mock

# Stripe publishable key (client-side) — required when VITE_PAYMENT_PROVIDER=stripe
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# API origin for all /api/* calls (required in production).
# All client-side calls to Vercel serverless functions go through apiUrl()
# which prefixes this base. On web (same-origin Vercel) you may leave it
# unset; on NATIVE (iOS/Android via Capacitor) it is MANDATORY because the
# shell origin is capacitor://localhost and relative /api/* URLs do not
# resolve. Production builds fail fast on start if neither variable is set.
# VITE_API_BASE_URL is the canonical name; VITE_STRIPE_BACKEND_URL remains a
# legacy fallback.
# VITE_API_BASE_URL=https://app.safix.digital
#
# Legacy backend base URL (kept for backwards compatibility). Prefer
# VITE_API_BASE_URL. NEVER put the Stripe secret key (sk_test_*/sk_live_*) in
# a VITE_* variable — it would be compiled into the client bundle.
# VITE_STRIPE_BACKEND_URL=https://api.fixup.com


# -----------------------------------------------------------------------------
# IN-APP PURCHASES — RevenueCat (native iOS only)
# -----------------------------------------------------------------------------
# iOS Public SDK Key — required for in-app subscription purchases on device.
# Find in: RevenueCat Dashboard → Projects → Apps → <Apple app> → Public SDK Key
#
# Key format rules:
#   iOS key starts with:      appl_  ← use this
#   Android key starts with:  goog_  ← do NOT use for iOS builds
#   RC Secret API Key:        different format — NEVER use as SDK key (causes 401)
#
# After changing this value you MUST rebuild and re-sync before testing on device:
#   npm run build && npx cap copy ios
#
# VERCEL:      Not required (IAP is native-only; omit for web deployments).
# XCODE CLOUD: Required — set in App Store Connect → Xcode Cloud → Workflow → Environment.
# VITE_REVENUECAT_PUBLIC_SDK_KEY=appl_...
#
# RevenueCat webhook secret (server-side only — NEVER prefix with VITE_):
# Bearer token configured in RC Dashboard → Integrations → Webhooks → Authorization header.
# Set in Vercel → Settings → Environment Variables (not in .env).
# REVENUECAT_WEBHOOK_SECRET=<your-webhook-secret>


# -----------------------------------------------------------------------------
# OBSERVABILITY (optional — client-side error tracking)
# -----------------------------------------------------------------------------
# Sentry DSN for client-side error reporting. When set, unhandled errors and
# warnings are forwarded to your Sentry project. Leave unset for local dev.
# Obtain the DSN from your Sentry project under Settings → Client Keys (DSN).
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
#
# Vercel automatically injects VERCEL_ENV and VERCEL_GIT_COMMIT_SHA at build
# time (no manual setup needed).  These are used via vite.config.ts define to
# set Sentry environment + release tags for deployment correlation.


# -----------------------------------------------------------------------------
# ADMIN / BACKOFFICE MODE
# -----------------------------------------------------------------------------
# VITE_ADMIN_MODE is no longer supported. This variable has been removed from
# the codebase. Operator access is granted exclusively via the profiles table:
#
#   UPDATE profiles SET is_operator = true WHERE id = '<user-uuid>';
#
# The session.isOperator flag is populated from that DB column and enforced by
# canAccessDisputeResolution() in src/lib/access/index.ts. Do not re-add any
# env-var-based operator access bypass.
# (removed) VITE_ADMIN_MODE=true


# =============================================================================
# SERVER-SIDE ONLY  (never prefix with VITE_ — these are NOT client variables)
# =============================================================================
# These variables are read exclusively by the Vercel serverless functions in
# api/. Do NOT add them to any VITE_* prefixed variable or they will be
# compiled into the client bundle.
#
# Set these in Vercel under Settings → Environment Variables.
#
# Server-side Sentry DSN — used by api/_observability.ts.
# When set, all server-side errors (webhook, cron, API) are captured in Sentry.
# Can share the same Sentry project as the client, or use a separate project.
# SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
#
# Source map upload (optional but recommended for readable production stack traces).
# Requires @sentry/vite-plugin installed as devDependency.
# See: https://docs.sentry.io/platforms/javascript/sourcemaps/uploading/vite/
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=<your-sentry-org>
# SENTRY_PROJECT=<your-sentry-project>

# STRIPE_SECRET_KEY=sk_test_...
#
# Stripe webhook signing secret — obtain from the Stripe Dashboard after
# registering the webhook endpoint:
#   https://<your-vercel-app>.vercel.app/api/stripe-webhook
# Subscribe to events: payment_intent.succeeded, payment_intent.requires_action,
#   payment_intent.payment_failed, payment_intent.canceled,
#   charge.refunded, refund.created, refund.failed,
#   account.updated, capability.updated
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Supabase project URL — same value as VITE_SUPABASE_URL but read server-side
# by the stripe-webhook reconciliation function.  Required for webhook
# state reconciliation.  NEVER prefix with VITE_ (not for the client bundle).
# SUPABASE_URL=https://<project-ref>.supabase.co
#
# Supabase service-role key — bypasses Row Level Security.
# Required by stripe-webhook to write payment and job state updates.
# NEVER expose this key client-side or in any VITE_* variable.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Restrict which origin may call the /api/* endpoints (optional).
# Defaults to '*' if not set. Set to your exact frontend origin in production.
# ALLOWED_ORIGIN=https://<your-app>.vercel.app
#
# Base URL for the deployed application — REQUIRED for Stripe Connect onboarding.
# This is used to generate return_url and refresh_url for the Stripe Connect
# onboarding flow. Without this variable, Stripe Connect onboarding will fail with
# a clear error message instead of silently falling back to localhost.
# On Vercel, use the production URL (e.g., https://<your-app>.vercel.app).
# APP_BASE_URL=https://<your-app>.vercel.app
#
# Escrow funding charge model (ZAG corridor cutover — Block P, phase P2).
# DEFAULT-OFF. Read by api/initiate-funding.ts with strict equality to the
# string 'true'; anything else (unset / '' / 'false' / '1') keeps the legacy
# Separate-Charges-and-Transfers model (single PI on the platform balance, no
# transfer_data, no application_fee_amount) — byte-identical to pre-P2 behaviour.
# When set to 'true' the funding PaymentIntent becomes a Destination Charge to
# the provider's connected account with an application fee.
# ⚠ MUST stay OFF / unset until P3 (release via stripe payouts.create on the
#   connected account) is built AND the ZAG legal gutachten signs off. With the
#   flag ON the funding money lands on the connected account, but
#   api/release-tranche.ts still transfers FROM the (now empty) platform balance
#   → release breaks. Do NOT enable in any environment yet.
# FUNDING_DESTINATION_CHARGE_ENABLED=false


# =============================================================================
# QUICK-START: Vercel production deployment checklist
# =============================================================================
# Minimum required variables for a Supabase-backed production deployment:
#
#   VITE_DATA_SOURCE          = supabase
#   VITE_SUPABASE_URL         = https://<ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY    = <anon-public-key>
#
# Add if using real Stripe payments:
#   VITE_PAYMENT_PROVIDER         = stripe
#   VITE_STRIPE_PUBLISHABLE_KEY   = pk_live_...
#   STRIPE_SECRET_KEY             = sk_live_...         (server-side only)
#   STRIPE_WEBHOOK_SECRET         = whsec_...           (server-side only)
#   SUPABASE_URL                  = https://<ref>.supabase.co  (server-side)
#   SUPABASE_SERVICE_ROLE_KEY     = eyJ...              (server-side only)
#   APP_BASE_URL                  = https://<your-app>.vercel.app  (REQUIRED for Stripe Connect)
#   VITE_API_BASE_URL             = https://<your-app>.vercel.app  (REQUIRED for native iOS/Android build)
#   VITE_STRIPE_BACKEND_URL       = legacy alias for VITE_API_BASE_URL (either one works)
#
# Add for error monitoring (recommended for production):
#   VITE_SENTRY_DSN               = https://<key>@o<org>.ingest.de.sentry.io/<project>
#   SENTRY_DSN                    = https://<key>@o<org>.ingest.de.sentry.io/<project>  (server-side)
#
# Add for readable production stack traces (optional):
#   SENTRY_AUTH_TOKEN             = sntrys_...         (build-time only)
#   SENTRY_ORG                    = <your-org>         (build-time only)
#   SENTRY_PROJECT                = <your-project>     (build-time only)
# =============================================================================


# =============================================================================
# QUICK-START: Xcode Cloud native iOS build
# =============================================================================
# ios/App/ci_scripts/ci_post_clone.sh validates these vars BEFORE running
# `npm run build`. If any are missing the build aborts with a FATAL message
# instead of producing a bundle that throws on first iOS startup
# ('[FixUp] Production build requires a Supabase data source.').
#
# Set these in:
#   App Store Connect → Apps → FixUp → Xcode Cloud → Edit Workflow → Environment
#
# Required (build will FATAL without them):
#   VITE_SUPABASE_URL              = https://<ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY         = <anon-public-key>
#   VITE_PAYMENT_PROVIDER          = stripe
#   VITE_STRIPE_PUBLISHABLE_KEY    = pk_live_...
#   VITE_API_BASE_URL              = https://<your-app>.vercel.app
#   VITE_REVENUECAT_PUBLIC_SDK_KEY = appl_...  (iOS Public SDK Key — NOT the RC Secret API Key)
#
# Forbidden in any VITE_* var (would ship in the client bundle):
#   - SUPABASE_SERVICE_ROLE_KEY     (server-only; never prefix with VITE_)
#   - STRIPE_SECRET_KEY             (server-only; never prefix with VITE_)
#   - REVENUECAT_WEBHOOK_SECRET     (server-only; never prefix with VITE_)
#   - VITE_DATA_SOURCE=in-memory    (production must use Supabase)
#
# IMPORTANT: After changing any VITE_* var, must rebuild before testing on device:
#   npm run build && npx cap copy ios
#
# Local validation of the same checks:
#   bash -x ios/App/ci_scripts/ci_post_clone.sh
# Reads $REPO_ROOT/.env (gitignored) automatically when run outside Xcode Cloud.
# =============================================================================

# =============================================================================
# Transactional email — Resend (server-side, Vercel env)
# =============================================================================
# Used by api/submit-widerruf.ts (§356a-Eingangsbestätigung — RECHTLICH PFLICHT),
# api/send-notification-email.ts und api/_emailDelivery.ts. Raw fetch gegen
# https://api.resend.com/emails (kein npm-Paket).
#
# RESEND_API_KEY      — Resend API key des Accounts, der die Absender-Domain besitzt.
# NOTIFICATION_FROM_EMAIL — verifizierter Absender, Format "Name <addr@domain>".
#
# WICHTIG: Die Domain in NOTIFICATION_FROM_EMAIL MUSS im zugehörigen Resend-Account
# verifiziert sein (DKIM+SPF-DNS), sonst lehnt Resend mit 403 ab und Mails an echte
# Empfänger schlagen fehl. 'onboarding@resend.dev' ist NUR Sandbox (liefert nur an
# die eigene Account-Adresse) — NICHT für Produktion.
# RESEND_API_KEY=re_...
# NOTIFICATION_FROM_EMAIL=SaFix <no-reply@safix.digital>
