.vercel
packages/*/.swiftpm/

# Spatial V1 binary assets (CC0 HDRIs + PBR + models).
# Repo tracks LICENSES.md + asset-manifest.json + the download helper;
# the actual files are pulled by `bash scripts/download-spatial-catalog.sh`
# locally or by a Vercel build-step in CI. Keeping them out of git keeps
# the clone fast.
public/spatial-assets/poc-bath/*
public/spatial-assets/poc-materials/*
public/spatial-assets/poc-hdri/*
public/spatial-assets/models/*
public/spatial-assets/materials/*
public/spatial-assets/hdri/*
!public/spatial-assets/poc-bath/.gitkeep
!public/spatial-assets/poc-materials/.gitkeep
!public/spatial-assets/poc-hdri/.gitkeep
