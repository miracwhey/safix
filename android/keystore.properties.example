# Upload-Keystore signing config for the Play Store release AAB.
#
# 1. Create the upload keystore (Leon owns the passwords — pick a strong one and
#    store it in the password manager; losing it means you cannot ship updates):
#
#      keytool -genkeypair -v \
#        -keystore android/app/safix-upload.jks \
#        -alias safix-upload \
#        -keyalg RSA -keysize 2048 -validity 10000 \
#        -dname "CN=Leon Karim Valentin, O=SaFix, L=Hannover, C=DE"
#
#    keytool prompts for the store + key password (use the same for both).
#
# 2. Copy this file to android/keystore.properties (git-ignored) and fill in the
#    real values. build.gradle reads it only if present.
#
# 3. Build the release bundle:  cd android && ./gradlew bundleRelease
#    → android/app/build/outputs/bundle/release/app-release.aab
#    Enable Play App Signing on first upload (Google manages the app signing key;
#    this keystore stays the UPLOAD key only).

storeFile=safix-upload.jks
storePassword=CHANGE_ME
keyAlias=safix-upload
keyPassword=CHANGE_ME
